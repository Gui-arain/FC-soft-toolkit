# MCU and Board
CONFIG_ARCH=arm
CONFIG_ARCH_CHIP=stm32h7
CONFIG_ARCH_CHIP_STM32H743ZI=y
CONFIG_ARCH_CHIP_STM32H7=y
CONFIG_ARCH_CHIP_STM32H7_CORTEXM7=y
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="shirley-fc-dev-board"
CONFIG_ARCH_BOARD_CUSTOM_DIR="../boards/arm/stm32h7/shirley-fc-dev-board"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD=shirley-fc-dev-board

# Cache
CONFIG_ARMV7M_DCACHE=y
CONFIG_ARMV7M_DCACHE_WRITETHROUGH=y
CONFIG_ARMV7M_DTCM=y
CONFIG_ARMV7M_ICACHE=y

# C++ support
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y

# Task/scheduler
CONFIG_SCHED_WAITPID=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RR_INTERVAL=200
CONFIG_TASK_NAME_SIZE=32 

CONFIG_BOARD_LOOPSPERMSEC=7184

# NSH shell
CONFIG_BUILTIN=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_LIBRARY=y
CONFIG_SYSTEM_NSH=y
CONFIG_NSH_READLINE=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_INIT_ENTRYPOINT="nsh_main"

# SPI peripherals
CONFIG_STM32H7_SPI4=y
CONFIG_STM32H7_SPI5=y

# I2C peripherals
CONFIG_STM32H7_I2C2=y

# UART for debug
CONFIG_STM32H7_USART2=y
CONFIG_USART2_SERIAL_CONSOLE=y
CONFIG_USART2_BAUD=115200
CONFIG_USART2_BITS=8
CONFIG_USART2_PARITY=0
CONFIG_USART2_2STOP=0
CONFIG_DEBUG_SYMBOLS=y

CONFIG_ARCH_STACKDUMP=y
CONFIG_PREALLOC_TIMERS=4

# Flash
CONFIG_INTELHEX_BINARY=y
CONFIG_RAW_BINARY=y

# RAM

CONFIG_MM_REGIONS=4

CONFIG_RAM_SIZE=245760
CONFIG_RAM_START=0x20010000

# Stack sizes (tune for your modules)
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_USERMAIN_STACKSIZE=4096

CONFIG_LINE_MAX=64

# Out-of-tree drivers (nuttxspace/drivers/)
CONFIG_SENSORS_ICM40609D=y